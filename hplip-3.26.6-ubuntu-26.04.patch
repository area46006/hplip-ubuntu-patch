+class _URLopener(object):
+    def __init__(self, proxies=None, **kwargs):
+        self.proxies = proxies or {}
+
+    def open(self, fullurl, data=None):
+        if '://' in fullurl:
+            urltype, url = fullurl.split('://', 1)
+        elif ':' in fullurl:
+            urltype, url = fullurl.split(':', 1)
+        else:
+            urltype = 'file'
+            url = fullurl
+        name = 'open_' + urltype.replace('-', '_')
+        if hasattr(self, name):
+            if data is None:
+                return getattr(self, name)(url)
+            else:
+                return getattr(self, name)(url, data)
+        return urllib_request.urlopen(fullurl, data)
+
+URLopenerBase = getattr(urllib_request, 'URLopener', _URLopener)
+
+
